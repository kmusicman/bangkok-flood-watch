# ---- scripts/ingest.ts --push (GitHub Actions / เครื่องในไทย) ----
WORKER_URL=https://flood-watch-api.<account>.workers.dev
INGEST_TOKEN=            # ต้องตรงกับ `wrangler secret put INGEST_TOKEN` ของ Worker

# ---- scripts/ingest.ts อ่านไฟล์ .env นี้เอง ----
GISTDA_API_KEY=         # key GISTDA แบบไม่จำกัด (ข้าม = ไม่ดึงชั้นดาวเทียม)

# ---- web/.env (Nuxt อ่านตอน dev/build) หรือ env ของ Cloudflare Pages ----
NUXT_PUBLIC_DATA_BASE=https://flood-watch-api.<account>.workers.dev/api/data
NUXT_PUBLIC_GISTDA_KEY= # key GISTDA แบบจำกัด HTTP referrer (โดเมนเว็บ + http://localhost:3000)

# ---- worker: ตั้งเป็น secret ด้วย `wrangler secret put` (dev ใช้ worker/.dev.vars) ----
# INGEST_TOKEN
# GISTDA_API_KEY
# ALLOWED_ORIGIN         # อยู่ใน wrangler.toml [vars]
